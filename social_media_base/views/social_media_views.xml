<odoo>

    <record model="ir.ui.view" id="social_media_view_kanban">
        <field name="name">social.media.kanban</field>
        <field name="model">social.media</field>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0" js_class="social_kanban">
                <field name="name" />
                <field name="description" />
                <field name="image" />
                <!-- `write_date` is read only to bust the image cache below. The
                     parser used to add it on its own whenever it saw
                     `kanban_image` in a `t-att-src`; with that helper gone the
                     field has to be asked for explicitly. -->
                <field name="write_date" />
                <templates>
                    <t t-name="card">
                        <div class="d-flex rounded">
                            <!-- The `kanban_image()` QWeb helper was removed in
                                 19.0. It is not deprecated-but-working: it is
                                 undefined, so the template dies at render with
                                 `ctx.kanban_image is not a function` and takes
                                 the whole view with it. Core builds the
                                 `/web/image/` URL by hand now, with `unique`
                                 carrying the write date so a replaced image is
                                 not served from cache. -->
                            <img
                                t-attf-src="/web/image/social.media/#{record.id.raw_value}/image?unique=#{record.write_date.raw_value}"
                                class="img img-fluid"
                                height="50"
                                width="100"
                                t-att-alt="record.name.raw_value"
                            />
                            <div class="d-flex flex-column p-2">
                                <h5 class="title" t-esc="record.name.raw_value" />
                                <p class="text" t-esc="record.description.raw_value" />
                                <button
                                    type="object"
                                    class="btn btn-primary"
                                    name="action_open_account"
                                >Associate account
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model="ir.actions.act_window" id="social_media_action">
        <field name="name">Social Media</field>
        <field name="res_model">social.media</field>
        <field name="view_mode">kanban</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
