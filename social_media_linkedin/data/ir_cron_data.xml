<odoo>
    <record id="ir_cron_linkedin_refresh_tokens" model="ir.cron">
        <field name="name">Social LinkedIn: Refresh expiring access tokens</field>
        <field name="model_id" ref="social_media_base.model_social_account" />
        <field name="state">code</field>
        <field name="code">
model.search([("media_type", "=", "linkedin")]).filtered(
    lambda a: a.expire_access_token_date
)._cron_refresh_linkedin_tokens()
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root" />
    </record>
</odoo>
